# Editor settings for this repository (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,txt,cmake,sh,yml}]
indent_style = space
indent_size = 4

[*.yml]
indent_size = 2

# Notes and guides: Logseq indents with tabs, and Markdown line breaks can be trailing spaces.
[*.md]
trim_trailing_whitespace = false
